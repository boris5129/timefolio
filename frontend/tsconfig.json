{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM", "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
